# Copy to .env.local and fill in. Required — analysis will not run without it.
ANTHROPIC_API_KEY=

# Optional: override the model used for analysis passes.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# SQLite via Prisma (prototype). Relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Optional: higher GitHub API quota for public-repo ingestion.
# GITHUB_TOKEN=
